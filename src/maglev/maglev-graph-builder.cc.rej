           value_to_push = BuildInlinedAllocationForHeapNumber(
               CreateHeapNumber(node->Cast<Float64Constant>()->value()),
               allocation_type);
         } else {
-          value_to_push = GetTaggedValue(node);
+          ValueNode* new_node = GetTaggedValue(node);
